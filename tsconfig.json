{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@app/auth": ["libs/auth/src"],
      "@app/auth/*": ["libs/auth/src/*"],
      "@app/aws": ["libs/aws/src"],
      "@app/aws/*": ["libs/aws/src/*"],
      "@app/cache": ["libs/cache/src"],
      "@app/cache/*": ["libs/cache/src/*"],
      "@app/common": ["libs/common/src"],
      "@app/common/*": ["libs/common/src/*"],
      "@app/config": ["libs/config/src"],
      "@app/config/*": ["libs/config/src/*"],
      "@app/database": ["libs/database/src"],
      "@app/database/*": ["libs/database/src/*"],
      "@app/grpc": ["libs/grpc/src"],
      "@app/grpc/*": ["libs/grpc/src/*"],
      "@app/logger": ["libs/logger/src"],
      "@app/logger/*": ["libs/logger/src/*"],
      "@app/messaging": ["libs/messaging/src"],
      "@app/messaging/*": ["libs/messaging/src/*"],
      "@app/monitoring": ["libs/monitoring/src"],
      "@app/monitoring/*": ["libs/monitoring/src/*"],
      "@app/security": ["libs/security/src"],
      "@app/security/*": ["libs/security/src/*"],
      "@app/testing": ["libs/testing/src"],
      "@app/testing/*": ["libs/testing/src/*"],
      "@app/telemetry": ["libs/telemetry/src"],
      "@app/telemetry/*": ["libs/telemetry/src/*"]
    }
  },
  "include": ["apps/**/*", "libs/**/*"],
  "exclude": ["node_modules", "dist", "test", "apps/web-shop/**", "**/*.spec.ts"]
}
