# Container-network database connection strings for scripts/compose-db-migrate.sh
# (used by the `bootstrap` compose service). Service names match docker-compose.yml
# so migrations run inside the compose network. Kept in sync with .env host ports.
DATABASE_URL=postgresql://root:password@auth_db:5432/auth_db?schema=public

PRODUCT_DATABASE_WRITE_URL=postgresql://root:password@product_db_master:5432/product_db?schema=public
PRODUCT_DATABASE_READ_URL=postgresql://root:password@product_db_replica:5432/product_db?schema=public

AUTH_S0_DATABASE_WRITE_URL=postgresql://root:password@auth_s0:5432/auth_s0?schema=public
AUTH_S0_DATABASE_READ_URL=postgresql://root:password@auth_s0_replica:5432/auth_s0?schema=public
AUTH_S1_DATABASE_WRITE_URL=postgresql://root:password@auth_s1:5432/auth_s1?schema=public
AUTH_S1_DATABASE_READ_URL=postgresql://root:password@auth_s1_replica:5432/auth_s1?schema=public

ORDER_S0_DATABASE_WRITE_URL=postgresql://root:password@order_s0:5432/order_s0?schema=public
ORDER_S0_DATABASE_READ_URL=postgresql://root:password@order_s0_replica:5432/order_s0?schema=public
ORDER_S1_DATABASE_WRITE_URL=postgresql://root:password@order_s1:5432/order_s1?schema=public
ORDER_S1_DATABASE_READ_URL=postgresql://root:password@order_s1_replica:5432/order_s1?schema=public
ORDER_S2_DATABASE_WRITE_URL=postgresql://root:password@order_s2:5432/order_s2?schema=public
ORDER_S2_DATABASE_READ_URL=postgresql://root:password@order_s2_replica:5432/order_s2?schema=public
ORDER_S3_DATABASE_WRITE_URL=postgresql://root:password@order_s3:5432/order_s3?schema=public
ORDER_S3_DATABASE_READ_URL=postgresql://root:password@order_s3_replica:5432/order_s3?schema=public

PRODUCT_S0_DATABASE_WRITE_URL=postgresql://root:password@product_s0:5432/product_s0?schema=public
PRODUCT_S0_DATABASE_READ_URL=postgresql://root:password@product_s0_replica:5432/product_s0?schema=public
PRODUCT_S1_DATABASE_WRITE_URL=postgresql://root:password@product_s1:5432/product_s1?schema=public
PRODUCT_S1_DATABASE_READ_URL=postgresql://root:password@product_s1_replica:5432/product_s1?schema=public
PRODUCT_S2_DATABASE_WRITE_URL=postgresql://root:password@product_s2:5432/product_s2?schema=public
PRODUCT_S2_DATABASE_READ_URL=postgresql://root:password@product_s2_replica:5432/product_s2?schema=public
PRODUCT_S3_DATABASE_WRITE_URL=postgresql://root:password@product_s3:5432/product_s3?schema=public
PRODUCT_S3_DATABASE_READ_URL=postgresql://root:password@product_s3_replica:5432/product_s3?schema=public
