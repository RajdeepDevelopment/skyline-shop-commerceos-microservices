{
  "name": "ecommerce-microservices",
  "version": "1.0.0",
  "description": "",
  "author": "Rajdeep Sadhu",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && nest build api-gateway && nest build auth-service && nest build order-service && nest build cart-service && nest build inventory-service && nest build payment-service && nest build product-service && nest build analytics-service",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:auth": "SERVICE_NAME=AUTH nest start --watch auth-service",
    "start:order": "SERVICE_NAME=ORDER nest start --watch order-service",
    "start:product": "SERVICE_NAME=PRODUCT nest start --watch product-service",
    "start:cart": "SERVICE_NAME=CART nest start --watch cart-service",
    "start:inventory": "SERVICE_NAME=PRODUCT nest start --watch inventory-service",
    "start:payment": "SERVICE_NAME=ORDER nest start --watch payment-service",
    "start:analytics": "SERVICE_NAME=PRODUCT nest start --watch analytics-service",
    "seed:db": "ts-node scripts/seed/seed-db.ts",
    "seed:api": "ts-node scripts/seed/seed-api.ts",
    "seed:es": "ts-node scripts/seed/sync-es.ts",
    "seed:verify": "ts-node scripts/seed/verify.ts",
    "db:migrate:local": "bash scripts/compose-db-migrate.sh",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/apps/ecommerce-microservices/main",
    "start:all": "pnpm concurrently -n gw,auth,order,cart,inventory,payment,product,analytics \"node dist/apps/api-gateway/main\" \"SERVICE_NAME=AUTH node dist/apps/auth-service/main\" \"SERVICE_NAME=ORDER node dist/apps/order-service/main\" \"SERVICE_NAME=CART node dist/apps/cart-service/main\" \"SERVICE_NAME=PRODUCT node dist/apps/inventory-service/main\" \"SERVICE_NAME=ORDER node dist/apps/payment-service/main\" \"SERVICE_NAME=PRODUCT node dist/apps/product-service/main\" \"SERVICE_NAME=PRODUCT node dist/apps/analytics-service/main\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/ecommerce-microservices/test/jest-e2e.json",
    "prepare": "husky",
    "release": "standard-version",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major",
    "floci:start": "docker compose -f docker-compose.floci.yml up -d",
    "floci:up": "pnpm floci:start && pnpm floci:seed && pnpm floci:ui",
    "floci:stop": "docker compose -f docker-compose.floci.yml down",
    "floci:logs": "docker logs -f ecommerce_floci",
    "floci:seed": "./scripts/floci-seed.sh",
    "floci:ui": "open http://localhost:4500",
    "floci:aws": "./scripts/floci-aws.sh",
    "deploy": "./scripts/deploy.sh",
    "deploy:floci": "./scripts/deploy.sh floci",
    "deploy:aws": "./scripts/deploy.sh aws",
    "aws:local": "./scripts/use-env.sh local",
    "aws:prod": "./scripts/use-env.sh aws",
    "aws:status": "./scripts/use-env.sh status",
    "infra:plan": "terraform -chdir=infrastructure/aws plan",
    "infra:apply": "terraform -chdir=infrastructure/aws apply",
    "infra:validate": "terraform -chdir=infrastructure/aws validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@aws-sdk/client-sns": "^3.1101.0",
    "@aws-sdk/client-sqs": "^3.1101.0",
    "@aws-sdk/client-ssm": "^3.1101.0",
    "@aws-sdk/client-sts": "^3.1101.0",
    "@clickhouse/client": "^1.23.1",
    "@elastic/elasticsearch": "^8.19.2",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.19",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.4.2",
    "@nestjs/terminus": "^11.1.1",
    "@opensearch-project/opensearch": "^3.6.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@types/cookie-parser": "^1.4.10",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.76.6",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express-basic-auth": "^1.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "nats": "^2.29.3",
    "nestjs-pino": "^4.6.1",
    "openpgp": "^6.3.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.20.0",
    "pg-copy-streams": "^7.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@prisma/config": "^7.8.0",
    "@testcontainers/postgresql": "^11.14.0",
    "@testcontainers/redis": "^11.14.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "jest": "^30.0.0",
    "joi": "^18.2.1",
    "lint-staged": "^17.0.3",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "standard-version": "^9.5.0",
    "supertest": "^7.0.0",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^.*generated/client/client$": "<rootDir>/test/__mocks__/generated-prisma-client.ts",
      "^@app/auth(|/.*)$": "<rootDir>/libs/auth/src/$1",
      "^@app/aws(|/.*)$": "<rootDir>/libs/aws/src/$1",
      "^@app/cache(|/.*)$": "<rootDir>/libs/cache/src/$1",
      "^@app/common(|/.*)$": "<rootDir>/libs/common/src/$1",
      "^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
      "^@app/database(|/.*)$": "<rootDir>/libs/database/src/$1",
      "^@app/grpc(|/.*)$": "<rootDir>/libs/grpc/src/$1",
      "^@app/logger(|/.*)$": "<rootDir>/libs/logger/src/$1",
      "^@app/messaging(|/.*)$": "<rootDir>/libs/messaging/src/$1",
      "^@app/monitoring(|/.*)$": "<rootDir>/libs/monitoring/src/$1",
      "^@app/security(|/.*)$": "<rootDir>/libs/security/src/$1",
      "^@app/testing(|/.*)$": "<rootDir>/libs/testing/src/$1",
      "^@app/telemetry(|/.*)$": "<rootDir>/libs/telemetry/src/$1"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@scarf/scarf",
      "msgpackr-extract",
      "protobufjs",
      "unrs-resolver",
      "husky",
      "cpu-features",
      "ssh2",
      "prisma",
      "@parcel/watcher"
    ]
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
