generator client {
  provider = "prisma-client"
  output   = "../libs/database/src/generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String
  passwordHash  String         @map("password_hash")
  roles         String[]       @default(["user"])
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  cart          Cart?
  orders        Order[]
  refreshTokens RefreshToken[]

  @@index([email])
  @@index([isActive])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

model Product {
  id                   String     @id @default(uuid())
  title                String
  description          String?
  category             String
  price                Decimal    @db.Decimal(10, 2)
  discountPercentage   Decimal    @default(0) @map("discount_percentage") @db.Decimal(5, 2)
  rating               Decimal    @default(0) @db.Decimal(3, 2)
  stock                Int        @default(0)
  tags                 String[]   @default([])
  brand                String?
  sku                  String     @unique
  weight               Decimal?   @db.Decimal(8, 2)
  width                Decimal?   @db.Decimal(8, 2)
  height               Decimal?   @db.Decimal(8, 2)
  depth                Decimal?   @db.Decimal(8, 2)
  warrantyInformation  String?    @map("warranty_information")
  shippingInformation  String?    @map("shipping_information")
  availabilityStatus   String     @default("In Stock") @map("availability_status")
  returnPolicy         String?    @map("return_policy")
  minimumOrderQuantity Int        @default(1) @map("minimum_order_quantity")
  barcode              String?
  qrCode               String?    @map("qr_code")
  images               String[]   @default([])
  thumbnail            String?
  isActive             Boolean    @default(true) @map("is_active")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")
  inventory            Inventory?
  reviews              Review[]

  @@index([sku])
  @@index([category])
  @@index([brand])
  @@index([isActive])
  @@index([rating])
  @@index([price])
  @@map("products")
}

model Review {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  rating        Int
  title         String?
  comment       String?
  date          DateTime @default(now())
  verified      Boolean  @default(false)
  helpfulCount  Int      @default(0) @map("helpful_count")
  reviewerName  String?  @map("reviewer_name")
  reviewerEmail String?  @map("reviewer_email")
  authorId      String?  @map("author_id")
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  helpfulVotes  ReviewHelpfulVote[]
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([productId])
  @@index([rating])
  @@index([authorId])
  @@map("reviews")
}

model ReviewHelpfulVote {
  id        String   @id @default(uuid())
  reviewId  String   @map("review_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId])
  @@index([userId])
  @@map("review_helpful_votes")
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  parentId  String?    @map("parent_id")
  createdAt DateTime   @default(now()) @map("created_at")
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")

  @@map("categories")
}

model Inventory {
  id          String   @id @default(uuid())
  productId   String   @unique @map("product_id")
  quantity    Int      @default(0)
  reservedQty Int      @default(0) @map("reserved_qty")
  updatedAt   DateTime @updatedAt @map("updated_at")
  product     Product  @relation(fields: [productId], references: [id])

  @@map("inventory")
}

enum ReservationStatus {
  RESERVED
  CONFIRMED
  RELEASED
  EXPIRED
}

model Warehouse {
  id             String                   @id @default(uuid())
  name           String                   @unique
  latitude       Decimal                  @db.Decimal(10, 7)
  longitude      Decimal                  @db.Decimal(10, 7)
  status         String                   @default("active")
  createdAt      DateTime                 @default(now()) @map("created_at")
  serviceability PincodeServiceability[]
  inventories    WarehouseInventory[]
  reservations   InventoryReservation[]

  @@index([status])
  @@map("warehouses")
}

model PincodeServiceability {
  id           String    @id @default(uuid())
  pincode      String    @map("pincode")
  warehouseId  String    @map("warehouse_id")
  priority     Int       @default(1)
  deliveryDays Int       @default(3) @map("delivery_days")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([pincode, warehouseId])
  @@index([pincode, active])
  @@map("pincode_serviceability")
}

model WarehouseInventory {
  id                String    @id @default(uuid())
  sku               String    @map("sku")
  warehouseId       String    @map("warehouse_id")
  availableQuantity Int       @default(0) @map("available_quantity")
  reservedQuantity  Int       @default(0) @map("reserved_quantity")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([sku, warehouseId])
  @@index([sku])
  @@map("warehouse_inventory")
}

model InventoryReservation {
  id          String            @id @default(uuid())
  sku         String            @map("sku")
  warehouseId String            @map("warehouse_id")
  quantity    Int
  orderId     String?           @map("order_id")
  status      ReservationStatus @default(RESERVED)
  expiryTime  DateTime          @map("expiry_time")
  createdAt   DateTime          @default(now()) @map("created_at")
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])

  @@index([orderId])
  @@index([status, expiryTime])
  @@map("inventory_reservations")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id        String  @id @default(uuid())
  cartId    String  @map("cart_id")
  productId String  @map("product_id")
  quantity  Int
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  status          OrderStatus @default(PENDING)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  shippingAddress String      @map("shipping_address")
  idempotencyKey  String?     @unique @map("idempotency_key")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  items           OrderItem[]
  user            User        @relation(fields: [userId], references: [id])
  payment         Payment?

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  productId String  @map("product_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String        @unique @map("order_id")
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  paymentMethod  String        @default("upi") @map("payment_method")
  gatewayRef     String?       @map("gateway_ref")
  idempotencyKey String?       @unique @map("idempotency_key")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  order          Order         @relation(fields: [orderId], references: [id])

  @@index([status])
  @@map("payments")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model OutboxMessage {
  id            String    @id @default(uuid())
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  payload       Json
  metadata      Json?
  published     Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")

  @@index([published, createdAt])
  @@map("outbox_messages")
}

model IdempotencyKey {
  key         String   @id
  requestHash String   @map("request_hash")
  response    Json?
  status      String   @default("pending")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}
