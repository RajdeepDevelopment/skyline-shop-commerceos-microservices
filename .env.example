# General
NODE_ENV=development
PORT=3000

# Database (PostgreSQL) - Main Connections
DATABASE_URL="postgresql://root:password@localhost:5433/auth_db?schema=public"

# Auth Shards (2 shards x 1 primary + 1 replica)
AUTH_S0_DATABASE_WRITE_URL="postgresql://root:password@localhost:5441/auth_s0?schema=public"
AUTH_S0_DATABASE_READ_URL="postgresql://root:password@localhost:5442/auth_s0?schema=public"
AUTH_S1_DATABASE_WRITE_URL="postgresql://root:password@localhost:5443/auth_s1?schema=public"
AUTH_S1_DATABASE_READ_URL="postgresql://root:password@localhost:5444/auth_s1?schema=public"

# Order Shards (4 shards x 1 primary + 1 replica)
ORDER_S0_DATABASE_WRITE_URL="postgresql://root:password@localhost:5451/order_s0?schema=public"
ORDER_S0_DATABASE_READ_URL="postgresql://root:password@localhost:5452/order_s0?schema=public"
ORDER_S1_DATABASE_WRITE_URL="postgresql://root:password@localhost:5453/order_s1?schema=public"
ORDER_S1_DATABASE_READ_URL="postgresql://root:password@localhost:5454/order_s1?schema=public"
ORDER_S2_DATABASE_WRITE_URL="postgresql://root:password@localhost:5455/order_s2?schema=public"
ORDER_S2_DATABASE_READ_URL="postgresql://root:password@localhost:5456/order_s2?schema=public"
ORDER_S3_DATABASE_WRITE_URL="postgresql://root:password@localhost:5457/order_s3?schema=public"
ORDER_S3_DATABASE_READ_URL="postgresql://root:password@localhost:5458/order_s3?schema=public"

# Product Shards (4 shards x 1 primary + 1 replica)
PRODUCT_S0_DATABASE_WRITE_URL="postgresql://root:password@localhost:5461/product_s0?schema=public"
PRODUCT_S0_DATABASE_READ_URL="postgresql://root:password@localhost:5462/product_s0?schema=public"
PRODUCT_S1_DATABASE_WRITE_URL="postgresql://root:password@localhost:5463/product_s1?schema=public"
PRODUCT_S1_DATABASE_READ_URL="postgresql://root:password@localhost:5464/product_s1?schema=public"
PRODUCT_S2_DATABASE_WRITE_URL="postgresql://root:password@localhost:5465/product_s2?schema=public"
PRODUCT_S2_DATABASE_READ_URL="postgresql://root:password@localhost:5466/product_s2?schema=public"
PRODUCT_S3_DATABASE_WRITE_URL="postgresql://root:password@localhost:5467/product_s3?schema=public"
PRODUCT_S3_DATABASE_READ_URL="postgresql://root:password@localhost:5468/product_s3?schema=public"

# Legacy Product URLs (backward compat)
PRODUCT_DATABASE_WRITE_URL="postgresql://root:password@localhost:5435/product_db?schema=public"
PRODUCT_DATABASE_READ_URL="postgresql://root:password@localhost:5436/product_db?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
REDIS_CLUSTER_MODE=false

# NATS JetStream
NATS_URL=nats://localhost:4222
NATS_CLUSTER_URLS=nats://localhost:4222,nats://localhost:4223,nats://localhost:4224,nats://localhost:4225,nats://localhost:4226

# Elasticsearch / OpenSearch
# SEARCH_BACKEND selects the client: elasticsearch (default, compose) or
# opensearch (AWS managed domains / Floci emulator).
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Authentication
JWT_SECRET=super_secret_enterprise_key_change_me_in_prod
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me_in_prod
JWT_REFRESH_EXPIRATION=7d

# API Gateway
API_GATEWAY_PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
AUTH_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
PRODUCT_SERVICE_PORT=3003
INVENTORY_SERVICE_PORT=3004
CART_SERVICE_PORT=3005
ORDER_SERVICE_PORT=3006
PAYMENT_SERVICE_PORT=3007
NOTIFICATION_SERVICE_PORT=3008
ANALYTICS_SERVICE_PORT=3009

# Microservices Hosts (for local dev, they are localhost, in docker use container names)
AUTH_SERVICE_HOST=localhost
USER_SERVICE_HOST=localhost
PRODUCT_SERVICE_HOST=localhost
INVENTORY_SERVICE_HOST=localhost
CART_SERVICE_HOST=localhost
ORDER_SERVICE_HOST=localhost
PAYMENT_SERVICE_HOST=localhost
NOTIFICATION_SERVICE_HOST=localhost
ANALYTICS_SERVICE_HOST=localhost

# gRPC Configuration
GRPC_AUTH_URL=localhost:50051
GRPC_USER_URL=localhost:50052
GRPC_PRODUCT_URL=localhost:50053
GRPC_INVENTORY_URL=localhost:50054
GRPC_CART_URL=localhost:50055
GRPC_ORDER_URL=localhost:50056
GRPC_PAYMENT_URL=localhost:50057
GRPC_NOTIFICATION_URL=localhost:50058
GRPC_ANALYTICS_URL=localhost:50059

# ---------------------------------------------------------------------------
# AWS — THE SWITCH
# ---------------------------------------------------------------------------
# The application talks to AWS through @app/aws, which reads these vars to pick
# between the local Floci emulator and real AWS. To switch, change only:
#
#   AWS_ENDPOINT_URL=http://localhost:4566   <-- LOCAL Floci emulation
#   AWS_ENDPOINT_URL=                        <-- REAL AWS (empty/unset)
#
# (see scripts/use-local.sh / scripts/use-aws.sh, or `pnpm aws:local` / `pnpm aws:prod`)

# Floci (local):  http://localhost:4566
# Real AWS:       (leave empty)
AWS_ENDPOINT_URL="http://localhost:4566"

# Floci (local):  test / test  (any non-empty values)
# Real AWS:       your real access key / secret key
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"

# Works for both
AWS_DEFAULT_REGION="us-east-1"

# App-level marker: "local" (Floci emulation) or "aws" (real AWS)
AWS_STORAGE_MODE="local"
